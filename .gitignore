# --- 凭据与本地状态：绝不入库 ---
*.local.json
*.secret.json
.credentials.yaml
credentials.yaml
.env
.env.*
!.env.example
*.pem
*.key
token.txt
cookie.txt

# --- 依赖与构建产物 ---
node_modules/
dist/
build/
*.tgz

# --- 运行时状态（含 SendKey 等本机配置）---
notify-config.json
serverchan-notify.json

# --- 编辑器 / 系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# --- 本地备份目录（形如 dsh-xxx.bak-20261014-1433）---
# 备份是本地保险，不是源码。入库只会让仓库里出现同一份代码的两个副本，
# 审阅者分不清哪个是权威版本。要留历史请用 git 本身。
*.bak-*
